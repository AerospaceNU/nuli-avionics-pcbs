	(text "We want to prioritize battery, if present\nD[1..0]=00, out=in2\nD[1..0]=10, out=in1\nSo D1=in1, D0=gnd, IN1=BATTERY, IN2=USB"
		(exclude_from_sim no)
		(at 182.88 73.66 0)
		(effects
